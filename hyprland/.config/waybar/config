{
  "layer": "top",
  "position": "top",
  "margin-bottom": -10,
  "spacing" : 0,
  "modules-left": [
  "hyprland/workspaces",
  "cpu"
  ],

  "modules-center": ["clock"],

  "modules-right": [
    "group/media",
    "network",
    "bluetooth",
    "pulseaudio",
    "backlight",
    "battery",
    "tray"
  ],

  "hyprland/workspaces": {
    "all-outputs": true,
    "format": "{icon}",
    "persistent-workspaces": { "*": [1,2,3,4,5,6,7,8,9] },
    "format-icons": {
    "1": "",      // Terminal
    "2": "👨‍💻",      // VS Code
    "3": "📔",      // Obsidian / Notes
    "4": "📔",      // Files / General
    "5": "📂",      // Whatever
    "6": "🗨️",      // Chat 
    "7": "🌐",      // Browser
    "8": "🌐",      // Browswer
    "9": "🎵",     // YT Music / Spotify
    "default": ""
    }
  },

  "tray": {
      "spacing": 15
  },

  "hyprland/window": {
    "format": "{}",
    "max-length": 40,
    "separate-outputs": false
  },

  "bluetooth": {
    "format": "󰂲",
    "format-on": "{icon}",
    "format-off": "{icon}",
    "format-connected":"{icon}",
    "format-icons":{
        "on":"󰂯",
        "off": "󰂲",
        "connected": "󰂱"
        },
    "on-click": "kitty -e bluetoothctl",
    "tooltip-format-connected":"{device_enumerate}"
  },

"mpris": {
    "format": "{player_icon} {dynamic}",
    "dynamic-order": ["title", "artist"],
    "dynamic-len": 35,
    "player-icons": {
        "spotify": "",
        "firefox": "󰈹",
        "default": "🎵"
    },
    "status-icons": {
        "paused": "⏸"
    },
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "tooltip": true
},

    "group/media": {
      "orientation": "horizontal",
      "modules": [
        "custom/media-animation",
        "custom/media-now-playing",
        "custom/media-time"
      ]
    },
    "custom/media-now-playing": {
      "exec": "~/.config/waybar/custom_modules/media/media-now-playing.sh",
      "escape": true,
      "tooltip": false,
      "on-click": "playerctl play-pause",
      "on-click-middle": "playerctl previous",
      "on-click-right": "playerctl next",
    },
    "custom/media-animation": {
      "exec": "~/.config/waybar/custom_modules/media/media-animation.sh",
      "tooltip": false,
    },
    "custom/media-time": {
      "exec": "~/.config/waybar/custom_modules/media/media-time.sh",
      "escape": true,
      "interval": 1,
      "tooltip": false,
    },

"clock": {
    "timezone": "Asia/Kolkata",
    "format": "{:%H:%M  -  %d, %A}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt>{calendar}</tt>",
    "calendar": {
        "format": {
            "today": "<span color='#99d1db'><b>{}</b></span>"
        },
        "mode": "month",
        "mode-mon-col": 3,
        "on-scroll": 1
    },
    "on-click": "firefox https://calendar.google.com"
 },

  "network": {
    "format-wifi": "󰤢",
    "format-ethernet": "󰈀 ",
    "format-disconnected": "󰤠 ",
    "interval": 5,
    "tooltip-format": "{essid} ({signalStrength}%)",
    "on-click": "kitty -e nmtui"

 },

  "cpu": {
    "interval": 1,
    "format": " {usage:>2}%",
    "on-click": "kitty -e btop"
  },

  "memory": {
    "interval": 30,
    "format": "  {used:0.1f}G/{total:0.1f}G",
    "tooltip-format": "Memory"
  },

  "custom/uptime": {
    "format": "{}",
    "format-icon": [""],
    "tooltip": false,
    "interval": 1600,
    "exec": "$HOME/.config/waybar/scripts/uptime.sh"
  },

  "backlight": {
        "format": "{icon}  {percent}%",
        "format-icons": ["","󰃜", "󰃛", "󰃞","󰃝","󰃟","󰃠"],
        "tooltip": false
  },

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "",
    "format-icons": {
      "default": ["", "", " "]
    },
    "on-click": "pavucontrol"
  },

  "battery": {
        "interval":2,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}  {capacity}%",
        "format-full": "{icon}  {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{icon} {time}",
        "format-icons": ["", "", "", "", ""]
  },

  "custom/lock": {
  "tooltip": false,
  "on-click": "sh -c '(sleep 0s; hyprlock)' & disown",
  "format" : ""
  },

  "custom/pomodoro": {
	"format": "{}",
	"return-type": "json",
	"exec": "waybar-module-pomodoro --no-work-icons",
	"on-click": "waybar-module-pomodoro toggle",
	"on-click-right": "waybar-module-pomodoro reset"
  }
}
